# Copy this file to .env and fill in your Supabase credentials
# NEVER commit .env to git

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Server-only — used by the /api Edge Functions, NOT by the Vite frontend.
# `npm run dev` doesn't execute /api at all (that's plain Vite); to test the
# API routes locally you need the Vercel CLI's `vercel dev` instead, which
# reads these two from .env as well. Never prefix these with VITE_ — that
# would bundle them into the browser build.
GROQ_API_KEY="your-groq-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
